# Database configuration
# Port 5432 is typical for native PostgreSQL; port 5433 is used by the included docker-compose.yml
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inventory_pos

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Frontend CORS origin
FRONTEND_URL=http://localhost:5173

# Secret key for sessions (must be at least 32 characters in production)
SECRET_KEY=dev-insecure-secret-key-do-not-use-in-production

# Session expiration in minutes (default 60)
SESSION_EXPIRE_MINUTES=60

# Automatically seed default demo accounts on startup/migration (manager / cashier)
SEED_DEMO_USERS=true
